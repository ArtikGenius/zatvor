[
  {
    "remarks": "Example \u00b7 Hysteria2-DNS (finalmask noise)",
    "log": {
      "loglevel": "warning"
    },
    "dns": {
      "servers": [
        "https://1.1.1.1/dns-query"
      ]
    },
    "inbounds": [
      {
        "tag": "socks",
        "listen": "127.0.0.1",
        "port": 10808,
        "protocol": "socks",
        "settings": {
          "udp": true
        }
      }
    ],
    "outbounds": [
      {
        "tag": "proxy",
        "protocol": "hysteria",
        "settings": {
          "version": 2,
          "address": "hy2.example.com",
          "port": 8443
        },
        "streamSettings": {
          "network": "hysteria",
          "security": "tls",
          "tlsSettings": {
            "serverName": "hy2.example.com",
            "alpn": [
              "h3"
            ]
          },
          "hysteriaSettings": {
            "version": 2,
            "auth": "REPLACE_ME_hysteria2_auth"
          },
          "finalmask": {
            "udp": [
              {
                "type": "salamander",
                "settings": {
                  "password": "REPLACE_ME_salamander_password"
                }
              },
              {
                "type": "noise",
                "settings": {
                  "reset": 0,
                  "noise": [
                    {
                      "type": "exp",
                      "packet": "<r 2><b 0x85800001000100000000076578616d706c6503636f6d0000010001c00c000100010000105a00045db8d70e>",
                      "delay": "5-10"
                    }
                  ]
                }
              }
            ],
            "quicParams": {
              "congestion": "bbr"
            }
          }
        }
      },
      {
        "tag": "direct",
        "protocol": "freedom"
      },
      {
        "tag": "block",
        "protocol": "blackhole"
      }
    ],
    "routing": {
      "domainStrategy": "IPIfNonMatch",
      "rules": [
        {
          "type": "field",
          "domain": [
            "geosite:category-ru",
            "domain:ru",
            "domain:su",
            "domain:xn--p1ai"
          ],
          "outboundTag": "direct"
        },
        {
          "type": "field",
          "ip": [
            "geoip:ru",
            "geoip:private"
          ],
          "outboundTag": "direct"
        },
        {
          "type": "field",
          "network": "tcp,udp",
          "outboundTag": "proxy"
        }
      ]
    }
  },
