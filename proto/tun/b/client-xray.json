{
  "_comment": "Variant B: the Xray that sing-tun (proto/tun/b) forwards to. SOCKS in on loopback, SOCKS out to the upstream. Check.ps1 replaces __LOG_DIR__.",
  "log": {
    "loglevel": "info",
    "access": "__LOG_DIR__/client-b-access.log",
    "error": "__LOG_DIR__/client-b-error.log"
  },
  "inbounds": [
    {
      "tag": "socks-in",
      "listen": "127.0.0.1",
      "port": 10808,
      "protocol": "socks",
      "settings": { "auth": "noauth", "udp": true, "ip": "127.0.0.1" }
    }
  ],
  "outbounds": [
    { "tag": "proxy", "protocol": "socks", "settings": { "address": "127.0.0.1", "port": 10800 } }
  ]
}
