{
  "_comment": "Stand-in for the remote server, on the same CI runner. Check.ps1 replaces __PHYS_IF__ with the physical adapter name and __LOG_DIR__ with its log dir. Its own egress is bound to that adapter (sockopt.interface) so it never loops into the TUN; it never sends DNS on port 53 (DoH to 1.1.1.1:443), and the probe destinations are redirected to local servers, so on the physical adapter any port 53/853 packet or any packet to a probe address is a leak.",
  "log": {
    "loglevel": "warning",
    "access": "__LOG_DIR__/upstream-access.log",
    "error": "__LOG_DIR__/upstream-error.log"
  },
  "dns": {
    "hosts": {
      "zatvor-probe.test": ["198.18.0.10", "2001:db8::10"]
    },
    "servers": ["https://1.1.1.1/dns-query"],
    "queryStrategy": "UseIP"
  },
  "inbounds": [
    {
      "tag": "socks-in",
      "listen": "127.0.0.1",
      "port": 10800,
      "protocol": "socks",
      "settings": { "auth": "noauth", "udp": true, "ip": "127.0.0.1" }
    }
  ],
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom",
      "streamSettings": { "sockopt": { "interface": "__PHYS_IF__" } }
    },
    {
      "tag": "dns-out",
      "protocol": "dns",
      "settings": {
        "rules": [
          { "action": "hijack", "qType": "1,28" },
          { "action": "return", "rCode": 5 }
        ]
      }
    },
    { "tag": "probe-http", "protocol": "freedom", "settings": { "redirect": "127.0.0.1:18080" } },
    { "tag": "probe-bench", "protocol": "freedom", "settings": { "redirect": "127.0.0.1:18081" } }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      { "type": "field", "port": "53", "outboundTag": "dns-out" },
      { "type": "field", "ip": ["198.18.0.10/32", "2001:db8::10/128", "1.1.1.1/32"], "port": "80", "outboundTag": "probe-http" },
      { "type": "field", "ip": ["198.18.0.20/32"], "port": "5201", "outboundTag": "probe-bench" }
    ]
  }
}
